CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# XIAO ESP32-C5: 8 MB flash; Wi-Fi + TLS + HTTP needs more than the 1 MB default app.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# GPIO11/12 (UART0) carry the STM32 link, so logs go over USB only.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Firebase sends GTS Root R1 cross-signed by the retired GlobalSign Root CA.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
