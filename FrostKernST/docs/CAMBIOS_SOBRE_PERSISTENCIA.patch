+static void PublishFlow(uint8_t nodeId)
+{
+    AppStatus status;
+    const uint8_t empty[8] = {0};
+    if (!AppIpc_ReadSlaveStatus(nodeId, &status) ||
+        memcmp(status.device.ieee_address, empty, sizeof(empty)) == 0) {
+        return;
